# 이 파일을 android/key.properties 로 복사한 뒤 실제 값으로 채운다.
# key.properties 와 .jks 는 절대 커밋하지 않는다 (android/.gitignore 에 등록돼 있음).
# 키스토어를 잃어버리면 같은 앱으로 업데이트를 올릴 수 없다 — 별도 백업 필수.
storePassword=키스토어_비밀번호
keyPassword=키_비밀번호
keyAlias=upload
# 리포지토리 밖 경로를 절대경로로. Windows 는 역슬래시를 두 번(\) 쓰거나 슬래시(/) 사용.
storeFile=C:/Users/Snet/keys/luckypicky-upload.jks
